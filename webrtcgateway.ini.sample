; SylkServer WebRTC gateway configuration file
;
; For the gateway to work Janus needs to be properly installed and configured,
; please refer to README.webrtc for detailed instructions
;

; [WebServer] section in config.ini must be properly configured for using
; HTTPS transport

[General]
; List of allowed web origins. The connection origin (Origin header in the
; HTTP request) will be checked against the list defined here, if the domain
; is no allowed the connection will be refused.
; * (the default) means any
; web_origins = *

; Proxy used for outbound SIP traffic. Bypassed when outbound_proxy_enabled
; is set in the [ThorNetwork] section of config.ini
; outbound_sip_proxy =

; List of allowed SIP domains for managing accounts
; sip_domains = *

; Boolean indicating if the WebSocket messages sent to/from clients should be
; logged to a file
; trace_client = False

; WebSocket Ping frames are sent at the configured interval, this helps detect
; dead client connections
; websocket_ping_interval = 120

; IP and port for the HTTP management interface as IP[:PORT]
; http_management_interface = 127.0.0.1:20888

; Shared secret for the HTTP management interface (Authorization: THE_KEY)
; http_management_auth_secret =

; Web page interactive login credentials
; https_management_interface = 127.0.0.1:20889
; http_management_admin_username = admin
; http_management_admin_password = your-strong-password

; Either management interface setting also accepts the special keyword
; 'builtin_webserver'. In that case no standalone listener is started for
; that setting; instead the admin API and web frontend are mounted on the
; main SylkServer web server (the [WebServer] section of config.ini) under
; /webrtcgateway/admin, e.g. https://example.com/webrtcgateway/admin/
; The main server's TLS settings decide between HTTP and HTTPS, so using
; the keyword on both settings is equivalent to using it on one. Because
; the main web server is normally reachable from the internet, the mount
; is refused unless authentication is configured (http_management_auth_secret
; and/or http_management_admin_username + http_management_admin_password).
; Note: internal tooling that talks to the plain-HTTP management port
; (e.g. sip-janus-bridge, the conference audio bridge's /rooms/events SSE
; subscription) must then be pointed at the built-in web server URL, or
; keep http_management_interface as a private address and set only
; https_management_interface = builtin_webserver
; http_management_interface = builtin_webserver
; https_management_interface = builtin_webserver

; Sylk-push URL to send conference push notification
; sylk_push_url =

; ---------------------------------------------------------------------------
; Push proxy
; ---------------------------------------------------------------------------
; Mirrors the push server's API on the main web server, so that clients which
; would otherwise talk to the push server directly go through SylkServer:
;
;     POST   /webrtcgateway/push/v2/tokens/<account>/push
;     POST   /webrtcgateway/push/v2/tokens/<account>/push/<device_id>
;     POST   /webrtcgateway/push/v2/tokens/<account>              (add token)
;     DELETE /webrtcgateway/push/v2/tokens/<account>              (remove token)
;
; Requests are relayed to the push server named by sylk_push_url above (only
; its scheme://host:port is used). The body is forwarded unmodified and the
; caller is acknowledged with 202 before the forward completes, so a slow or
; unreachable push server cannot delay the caller. The push server's response
; is logged, not relayed.
;
; A client needs only its base push URL changed to
; https://example.com/webrtcgateway/push, or to
; https://example.com/webrtcgateway/push/auth/YOUR_SECRET when it cannot send
; the shared secret in a header.
;
; sylk_push_proxy = True

; Shared secret the caller must present, in an X-Sylk-Push-Auth header, an
; Authorization header, or in the URL under /push/auth/<secret>/
; sylk_push_proxy_secret =

; Source address ACL. Same syntax as [SIP] trusted_peers in config.ini: comma
; separated IPv4 addresses or CIDR networks, plus the keywords 'any'/'none'
; and 'thor_network'. With 'thor_network' a request is accepted when its
; source address belongs to a node currently in the Thor network; it requires
; [ThorNetwork] enabled in config.ini and can be combined with explicit
; ranges, which always apply:
;
;     sylk_push_proxy_allowed_ips = thor_network
;     sylk_push_proxy_allowed_ips = thor_network, 10.0.0.0/8
;
; When both this and sylk_push_proxy_secret are set, both must match. At least
; one of the two must be set: the route is served by the public web server, so
; the proxy refuses to run unauthenticated.
; sylk_push_proxy_allowed_ips = 127.0.0.1, 10.0.0.0/8

; Connect/response timeout in seconds when forwarding to the push server
; sylk_push_proxy_timeout = 10

; XCAP URL to manage addressbooks
; xcap_url =

; Send sip messages only to ourself, skipping any outbound destination.
; This setting should be enabled if you have no SIP proxy, no outbound proxy
; configured and a different authentication method. You should also add the
; listening IP to the trusted list in the main configuration
; local_sip_messages =

; Application directory. This set the path where the application stores non
; temporary files
; application_dir = /var/lib/sylkserver/webrtcgateway

; Remove big transfered files (> 50MB) after this amount of days. Smaller
; files (< 50MB) will be removed after 2 * filetransfer_expire_days
; filetransfer_expire_days = 15

[Janus]
; URL pointing to the Janus API endpoint (only WebSocket is supported)
; api_url = ws://127.0.0.1:8188

; API secret shared with Janus (must match the value in janus.cfg)
; A random UUID value is recommended, a new value can be generated with
; the following command:
; python -c 'import uuid; print(uuid.uuid4().hex)'
api_secret = 0745f2f74f34451c89343afcdcae5809

; Boolean indicating if the messages between SylkServer and Janus should be
; logged to a file
; trace_janus = False

; Maximum video bitrate allowed per sender in a room in bits/s. This value is
; applied to any room that doesn't define its own. The value is any integer
; number between 64000 and 4194304. Default value is 2016000 (~2Mb/s).
; max_bitrate = 2016000

; The video codec to be used by all participants in a room. This value is
; applied to any room that doesn't define its own.
; Possible values are: h264, vp8 and vp9. Default is vp9.
; video_codec = vp9

; code used to decline the calls (usually, 486 busy, 603 busy everywhere).
; For 4XX codes, tipically a SIP Proxy will wait until other devices answer,
; for 6XX codes, tipically a SIP Proxy will end the call forking
; decline_code = 486


[Cassandra]
; Contact points to cassandra cluster
; cluster_contact_points =

; Keyspace to use for storage
; keyspace =

; Table name for token storage
; push_tokens_table = push_tokens

; Per room configuration options
; [room1@videoconference.example.com]
; record = True
; access_policy = deny, allow
; deny = all
; allow = domain1.com, test1@example.com, test2@example.com
; max_bitrate = 512000
; video_codec = h264
; video_disabled = False
; invite_participants = test@example.com
; persistent = False

