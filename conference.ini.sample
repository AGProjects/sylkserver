; SylkServer Conference application configuration file

[Conference]

; Replay last chat messages after joining a room
; history_size = 20

; Directory for storing files transferred to rooms (a subdirectory for each
; room will be created)
file_transfer_dir = /var/spool/sylkserver

; File transfer push support. If enabled files will be pushed to all active
; participants after receiving the file
; push_file_transfer = False

; Directory where images used by the Screen Sharing functionality will be stored
screensharing_images_dir = /var/spool/sylkserver/conference/screensharing

; Advertise XMPP support in conference URIs and welcome (text) message
; advertise_xmpp_support = False

; Comma separated list of PSTN numbers to advertise as a conference URI
; pstn_access_numbers =

; URL where the rooms can be joined using a WebRTC browser, the URL may contain
; the $room token which will be replaced by the room URI in user@domain form
; webrtc_gateway_url = https://webrtc.sipthor.net/call/$room

; Automatically verify ZRTP endpoints if the following conditions are met:
;  - The session also has a chat stream with no relay in between
;  - A MSRP message of type application/blink-zrtp-sas is received with the
;    remote SAS
;  - The remote and the local SAS match
; If this setting is set to True, SylkServer will send the ZRTP SAS to the
; connected endpoints via a private chat message
; zrtp_auto_verify = True

; Access Lists Default Policy
; Apache-style access lists for the caller using SIP domains or SIP URIs
; https://httpd.apache.org/docs/2.2/mod/mod_authz_host.html#order
;
; access_policy = allow, deny
; allow = all
; deny = none
;
; Disable music on hold globally. When set to True it forces MoH off for
; every conference room and overrides any per-room disable_music_on_hold
; setting (which is otherwise honored). Default: False.
; disable_music_on_hold = False

; If set, every incoming INVITE is inspected for this header; when present
; with body 'Yes' (case-insensitive), MoH is disabled for the room the caller
; joins, for the rest of that room's lifetime. Leave empty to skip the check.
; Default: empty (no header check).
; moh_disable_header = X-Disable-Moh

; A SIP-to-Janus audio bridge identifies itself by adding
;   ;app=<audio_bridge_app_param>
; to its INVITE Request-URI. When the conference application sees that
; parameter it answers immediately (no 4-second human ringback delay)
; and disables music-on-hold for the joining room. Set to an empty
; string to disable the detection entirely. Default: sylk-janus-audio-bridge.
; audio_bridge_app_param = sylk-janus-audio-bridge

; Conference selector (IVR). Calls to <default_conference_selector>@<domain>
; trigger a voice prompt that collects a conference number via DTMF; the same
; session then continues into <digits>@<domain> as if the caller had dialed
; that conference directly. The prompts are loaded from asterisk_sounds_dir,
; which should point at an asterisk-core-sounds-en-wav installation.
; Default: 'conference' / '/usr/share/asterisk/sounds/en'.
; default_conference_selector = conference
; asterisk_sounds_dir = /usr/share/asterisk/sounds/en
; select_conference_prompt = conf-getconfno.wav
; select_conference_invalid_prompt = conf-invalid.wav
; select_conference_goodbye_prompt = vm-goodbye.wav
; select_conference_max_digits = 32
; select_conference_initial_timeout = 10
; select_conference_interdigit_timeout = 5
; select_conference_overall_timeout = 60

; ----------------------------------------------------------------------
; Administrative HTTP API
; ----------------------------------------------------------------------
;
; Per-room admin API exposing participants, audio levels and mute/kick
; commands. host:port; bearer-token auth via http_management_auth_secret
; or the per-room token published in conference-info NOTIFY for the
; audio-bridge participant.
;
; Default host is auto-picked at startup: the first private IPv4 of a
; non-virtual interface (Docker/k8s/VPN tunnels skipped); falls back to
; 127.0.0.1 when nothing routable is found. Override with a specific
; bind address here if needed. Set to empty to disable the API entirely.
;
; http_management_interface = 0.0.0.0:10889
; http_management_auth_secret =

; ----------------------------------------------------------------------
; Real-time audio-level publishing
; ----------------------------------------------------------------------
;
; Sampling cadence (ms). Cheap (one pjmedia call per audio stream per
; tick); drives the 4Hz notify push and the 5s log line. Set to 0 to
; disable the periodic sampling entirely.
; audio_level_sample_period = 100
;
; How often (seconds) a per-room summary log line is emitted with
; mean/peak tx/rx per participant. Set to 0 to disable the log.
; audio_level_log_period = 5
;
; How often (ms) the ConferenceRoomAudioLevels notification fires.
; Consumed by the admin SSE stream and by the UDP server.
; audio_level_notify_period = 250
;
; ---- audio-level UDP server (subscribe-pull) -------------------------
;
; UDP server endpoint for cross-host real-time audio-level streaming.
; The conference focus runs the server here; webrtcgateways on OTHER
; hosts discover the endpoint via the agp-conf:audio_levels_udp_endpoint
; extension published in conference-info NOTIFY and subscribe via UDP.
;
; Default: 0.0.0.0:11000 (bind on every interface). Set to a specific
; address (e.g. 10.208.117.121:11000) when the host is multi-homed
; and you want replies sourced from a known IP — avoids the asymmetric-
; routing failure mode where the gateway sees the subscribe go out
; via one NIC but the audio-levels datagrams come back via another.
; Set to empty to disable the UDP server entirely.
; audio_level_udp_listen = 0.0.0.0:11000
;
; Externally-reachable host:port string PUBLISHED in conference-info
; NOTIFY (as <agp-conf:audio_levels_udp_endpoint>). Set this when
; audio_level_udp_listen binds to 0.0.0.0 / an internal interface and
; the routable address from a remote webrtcgateway's point of view is
; different (NAT, dual-homed host, container hostname etc). Leave
; empty to advertise the picker's choice — same private-IPv4 picker
; that http_management_interface uses by default.
; audio_level_udp_advertised_endpoint =
;
; Shared secret required on every inbound UDP subscribe/unsubscribe
; datagram. Defaults to http_management_auth_secret when unset.
; audio_level_udp_token =

; Access Lists can be applied per room overriding the Default Policy
;
; [test@domain.com]
; access_policy = allow, deny
; allow = example.com, test@domain.com
; deny = all
;
; Disable music on hold, can be applied per room overriding the Default Policy
; disable_music_on_hold = False

; ----------------------------------------------------------------------
; Per-room SIP REGISTER at a foreign domain
; ----------------------------------------------------------------------
;
; Make a conference room reachable as a regular SIP account on a third-
; party SIP provider — typically to give a PSTN gateway something to dial
; into. For each room section listed below, the conference application
; creates a sipsimple Account at startup, REGISTERs perpetually at the
; configured registrar, and routes any inbound INVITE arriving at the
; registered Contact into THIS room.
;
; Settings (all three are needed for a working registration):
;
;   registrar_uri            = user@foreign.example     ; AOR to register
;                                                       ; (becomes the SIP
;                                                       ; account at the
;                                                       ; foreign domain)
;   password                 = secret                    ; auth password
;   registrar_outbound_proxy = host[:port][;transport=udp|tcp|tls]
;                                                       ; optional explicit
;                                                       ; outbound proxy.
;                                                       ; Empty => DNS
;                                                       ; lookup on the
;                                                       ; registrar domain.
;
; Example: expose the conference room "team-standup@conf.example.org" as
; the SIP account "+15551234567@sip-trunk.example.net" at the trunk
; provider, so any call routed to that AOR (e.g. a PSTN number that the
; trunk maps to it) drops the caller straight into the conference.
;
; [team-standup@conf.example.org]
; access_policy            = deny, allow
; deny                     = all
; allow                    = example.org, partner.example.net
; registrar_uri            = +15551234567@sip-trunk.example.net
; password                 = CHANGE_ME
; registrar_outbound_proxy = sip-trunk.example.net:5060;transport=udp

