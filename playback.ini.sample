; Playback application configuration

[Playback]
; commented values are the defaults

; files_dir = /usr/share/sylkserver/sounds/

; Toggle video support (SylkServer will send a color bar)
; enable_video = False

; Delay for answering sessions
; answer_delay = 1

; Max seconds to play silence when no file is set (0 = until caller hangs up)
; timeout = 60

; Enable replies from Chuck Norris on SIP Message
; enable_chuck_norris_reply = True

; Log per-call RTP statistics (RTT, loss, RX/TX bandwidth), one line per
; stream every rtp_statistics_interval seconds, prefixed by Call-ID and caller
; rtp_statistics_enabled = False
; rtp_statistics_log = /var/log/sylkserver/playback/rtp.log
; rtp_statistics_interval = 5

; [test@conference.example.com]
; file = test.wav
; enable_video, answer_delay, timeout and enable_chuck_norris_reply can be overridden here

; Leave 'file' unset to play silence instead of a wav file:
; [silence@conference.example.com]
; timeout = 30

[playback]
file = moh/Cool_Grass_vbr.wav
enable_video = True
answer_delay = 2
enable_chuck_norris_reply = True
